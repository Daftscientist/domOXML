{
  "compilerOptions": {
    "target": "es2022", "lib": ["ES2023", "DOM", "DOM.Iterable"], "module": "esnext", "moduleResolution": "bundler",
    "jsx": "react-jsx", "strict": true, "noEmit": true, "skipLibCheck": true, "types": ["vite/client"],
    "noUnusedLocals": true, "noUnusedParameters": true, "verbatimModuleSyntax": true
  },
  "include": ["src"]
}
